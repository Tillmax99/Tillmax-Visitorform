rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Visitors can only ADD a lead; nobody can read, change or delete from the website.
    match /booth_leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','requirements','booth','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 40
        && request.resource.data.requirements is string && request.resource.data.requirements.size() <= 1000
        && request.resource.data.booth is string && request.resource.data.booth.size() <= 100
        && request.resource.data.createdAt == request.time;
      // Only the admin (signed in with Email/Password) can read the leads.
      allow read: if request.auth != null && request.auth.token.email == 'YOUR_ADMIN_EMAIL';
      allow update, delete: if false;
    }
  }
}
